# Production Compose template. The real .env belongs only on the VPS.
# Do not copy the development backend .env into an image or commit this file filled in.
HYDROMATE_APP_KEY=
HYDROMATE_POSTGRES_PASSWORD=
HYDROMATE_DB_PASSWORD=
HYDROMATE_DB_DATABASE=hydromate
HYDROMATE_DB_USERNAME=hydromate
HYDROMATE_APP_URL=http://localhost:8081
HYDROMATE_IMAGE_TAG=production

# Optional mqtt profile: admin supplies passwd, fullchain.pem and privkey.pem here.
HYDROMATE_MQTT_SECRETS_DIR=./deployment/secrets/mqtt
HYDROMATE_MQTT_BRIDGE_PASSWORD=
HYDROMATE_MQTT_BIND_ADDRESS=127.0.0.1
